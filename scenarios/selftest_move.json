{
  "_comment": "Used by `hx selftest --unity` with the generated sample scene. Proves virtual-device input -> game's own InputAction -> movement -> probes -> thresholds, with no harness code in the 'game'.",
  "scene": "HarnessSelfTest",
  "timeout": 60,
  "probes": [
    {"name": "selftest.speed", "target": "Player", "component": "SelfTestMover", "member": "CurrentSpeed"},
    {"name": "selftest.z", "target": "Player", "component": "Transform", "member": "position.z"}
  ],
  "steps": [
    {"action": "wait", "duration": 0.5},
    {"action": "press", "control": "<Keyboard>/w", "duration": 2},
    {"action": "screenshot", "name": "moved"}
  ],
  "expect": {
    "selftest.speed.max": {"min": 4.9, "max": 5.1},
    "selftest.z.last": {"min": 8, "max": 12}
  }
}
