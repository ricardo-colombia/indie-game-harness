      "Bash(curl:*)", "Bash(wget:*)", "Bash(rm -rf:*)",
      "Read(./game/Library/**)", "Read(./game/Temp/**)", "Read(./game/Logs/**)",
      "Edit(./harness/**)", "Edit(./.claude/**)", "Edit(./design/PILLARS.md)", "Edit(./backlog/**)",
      "WebFetch", "WebSearch"
